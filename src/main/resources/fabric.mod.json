{
  "schemaVersion": 1,
  "id": "terrainradar",
  "version": "${version}",
  "name": "TerrainRadar",
  "description": "Hides the rendering of specified blocks, revealing the real terrain. A pure client-side Fabric mod.",
  "authors": ["DingCouqui"],
  "environment": "client",
  "entrypoints": {
    "client": ["com.dingcouqui.terrainradar.TerrainRadarClient"],
    "modmenu": ["com.dingcouqui.terrainradar.modmenu.ModMenuIntegration"]
  },
  "mixins": [
    "terrainradar.mixins.json",
    "terrainradar.sodium.mixins.json"
  ],
  "icon": "assets/terrainradar/icon.png",
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "1.21.11",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": ">=17.0.0",
    "sodium": "*",
    "iris": "*"
  }
}
